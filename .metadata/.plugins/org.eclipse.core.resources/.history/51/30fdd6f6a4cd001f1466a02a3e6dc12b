package EXO3;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

public class Wild {

  
    public static <T extends CharSequence> List listLength(List<T> list) {
        List length = new ArrayList<>();
        for (T seq : list) {
            length.add(seq.length());
        }
        return length;
    }
    
    
    // wild cards
    
    public static List listLengthwild(List<?extends CharSequence> list) {
    	List length = new ArrayList<>();
        for (Object seq : list) {
            length.add(((CharSequence)seq).length());
        }
        return length;
    }

    public static void main(String[] args) {
        List<String> l = Arrays.asList("colonel", "reyel");
        System.out.println(listLength(l)); 
        
        List<StringBuilder> l2 = Arrays.asList(new StringBuilder("hello"), new StringBuilder("programming"));
        System.out.println(listLength(l2));
    }
}
