package EXO4;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

public class Fusion {

    // Generic fusion method that works with CharSequence or its subclasses
    public static <T extends CharSequence> List<T> fusion(List<T> list1, List<T> list2) {
        List<T> res = new ArrayList<>();
        for (int i = 0; i < list1.size(); i++) {
            res.add(list1.get(i));  // Add element from list1
            res.add(list2.get(i));  // Add element from list2
        }
        return res;
    }

    public static void main(String[] args) {
        List<String> l1 = Arrays.asList("C", "rc");
        List<StringBuilder> l2 = Arrays.asList(new StringBuilder("a ma"), new StringBuilder("he!"));

        // Now fusion works with CharSequence (String and StringBuilder are valid)
        List<? extends CharSequence> r1 = fusion(l1, l2);
        System.out.println(r1);

        // Another case: fusion of two lists of integers
        List<Integer> l3 = Arrays.asList(1, 2);
        List<Integer> l4 = Arrays.asList(10, 20);
        List<Integer> r3 = fusion(l3, l4);
        System.out.println(r3);

        // Uncommenting this will result in an error due to incompatible types (String and Integer)
        // List<?> r4 = fusion(l1, l3); // Not allowed due to different types
    }
}
