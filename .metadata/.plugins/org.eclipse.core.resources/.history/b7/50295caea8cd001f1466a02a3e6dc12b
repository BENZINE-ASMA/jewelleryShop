package EXO4;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

public class ListFusion {
    public static <T> List<T> fusion(List<? extends T> list1, List<? extends T> list2) {
        if (list1.size() != list2.size()) {
            throw new IllegalArgumentException("Les deux listes doivent être de la même taille.");
        }

        List<T> fusionedList = new ArrayList<>(list1.size() + list2.size());

        for (int i = 0; i < list1.size(); i++) {
            fusionedList.add(list1.get(i));
            fusionedList.add(list2.get(i));
        }

        return fusionedList;
    }

    public static void main(String[] args) {
        List<String> list1 = Arrays.asList("C", "rc");
        List<StringBuilder> list2 = Arrays.asList(new StringBuilder("a ma"), new StringBuilder("he!"));
        List<Object> charSequence = fusion(list1, list2);
        System.out.println("Fusion de deux listes de String/StringBuilder : " + charSequence);

        List<Integer> list3 = Arrays.asList(1, 2);
        List<Integer> list4 = Arrays.asList(10, 20);
        List<Object> list5 = fusion(list3, list4);
        System.out.println("Fusion de deux listes d'Integer : " + list5);
    }
}